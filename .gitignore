# Hugo
public/
resources/_gen/
.hugo_build.lock

# Python
__pycache__/
*.pyc
.venv/

# Google service-account keys must never be committed
*service-account*.json
*serviceaccount*.json
credentials.json

# Editors / OS
.DS_Store
*.swp

# REX are generated at build time from the Google Sheet — never committed
content/rex/*.md
!content/rex/_index.md
